# GEMINI_API_KEY: Required for official Google GenAI SDK (@google/genai) API calls.
# Obtain your key from https://aistudio.google.com/app/apikey
# Copy this file to .env and set GEMINI_API_KEY="your_actual_gemini_api_key"
GEMINI_API_KEY=

# APP_URL: The hosting URL (optional)
APP_URL="http://localhost:3000"
